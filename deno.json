{
  "tasks": {
    "dev": "deno run -A --node-modules-dir npm:vite",
    "build": "deno run -A --node-modules-dir npm:vite build",
    "preview": "deno run -A --node-modules-dir npm:vite preview",
    "serve": "deno run --allow-net --allow-read --allow-env backend/server.ts",
    "dev:serve": "APP_ENV='development' deno run --watch --allow-net --allow-read --allow-env --unstable-kv backend/server.ts",
    "install-browsers": "deno run -A e2e/install_browsers.ts",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env --unstable-kv backend/",
    "test:coverage": "deno test --coverage=./coverage --allow-write --unstable-kv backend/",
    "test:frontend": "deno run -A --node-modules-dir npm:vitest run",
    "test:all": "deno task test && deno task test:frontend",
    "test:e2e": "./e2e/run_e2e.sh"
  },
  "imports": {
    "vue": "npm:vue@3.5.44",
    "vite": "npm:vite@8.3.4",
    "@vitejs/plugin-vue": "npm:@vitejs/plugin-vue@6.0.10",
    "vue-router": "npm:vue-router@5.4.0",
    "@vueuse/core": "npm:@vueuse/core@15.0.0",
    "tailwindcss": "npm:tailwindcss@4.3.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.3.3",
    "@/": "./",
    "playwright": "npm:playwright@1.64.0",
    "expect": "npm:expect@30.5.2",
    "@testing-library/dom": "npm:@testing-library/dom@10.4.2",
    "playwright-testing-library": "npm:playwright-testing-library@4.5.0",
    "vitest": "npm:vitest@5.0.4",
    "@vue/test-utils": "npm:@vue/test-utils@2.5.1",
    "happy-dom": "npm:happy-dom@21.0.1"
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": "P7D",
  "compilerOptions": {
    "lib": [
      "deno.unstable",
      "deno.ns",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ]
  },
  "fmt": {
    "semiColons": false,
    "lineWidth": 100,
    "exclude": [".vite/", "dist", "node_modules"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": [".vite/", "dist", "node_modules"]
  },
  "test": {
    "exclude": [".vite/", "dist", "node_modules", "src/", "wsMsg/"]
  },
  "unstable": ["kv"]
}
